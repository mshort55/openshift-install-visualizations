{
  "name": "openshift-install-visualizations",
  "private": true,
  "type": "module",
  "scripts": {
    "app:decisions": "npm --prefix apps/install-decisions run app --",
    "app:journey": "npm --prefix apps/install-journey run app --",
    "build": "npm run build:decisions && npm run build:journey",
    "build:decisions": "npm --prefix apps/install-decisions run build",
    "build:journey": "npm --prefix apps/install-journey run build",
    "preview:decisions": "npm --prefix apps/install-decisions run preview --",
    "preview:journey": "npm --prefix apps/install-journey run preview --",
    "test": "npm run test:decisions && npm run test:journey && vitest run",
    "test:decisions": "npm --prefix apps/install-decisions test",
    "test:journey": "npm --prefix apps/install-journey test",
    "typecheck": "tsc --noEmit && npm --prefix apps/install-decisions run typecheck && npm --prefix apps/install-journey run typecheck",
    "lint": "biome check .",
    "check": "npm run typecheck && npm run lint && npm test",
    "check:decisions": "npm --prefix apps/install-decisions run check",
    "check:journey": "npm --prefix apps/install-journey run check"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@types/node": "^24.19.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
